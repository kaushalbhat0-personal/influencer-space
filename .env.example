# ============================================================================
# CreatorStore — Environment Variables
# Copy to .env.local and fill in your real values.
# Run `node scripts/validate-env.mjs` to verify before deployment.
# ============================================================================

# ─── Database ───────────────────────────────────────────────────────────────
# Pooled connection (PgBouncer, port 6543) — used at runtime by Prisma
DATABASE_URL="postgresql://[USER]:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true&sslmode=require&uselibpqcompat=true"
# Direct connection (port 5432) — required by prisma migrate / db push
DIRECT_URL="postgresql://[USER]:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://influencer-space-alpha.vercel.app"
NEXT_PUBLIC_PLATFORM_BASE_DOMAIN="creatorspace.app" # base domain for tenant subdomains
PLATFORM_BASE_DOMAIN="creatorspace.app"             # server-side override
NEXTAUTH_URL="https://influencer-space-alpha.vercel.app"
NEXTAUTH_SECRET="your-random-secret-here"          # openssl rand -base64 32
DEFAULT_TENANT_SUBDOMAIN="snax"                     # fallback tenant host

# ─── Security ───────────────────────────────────────────────────────────────
CRON_SECRET="your-random-cron-secret"              # openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="your-64-char-hex-key"        # openssl rand -hex 32
HEALTH_SECRET="your-random-health-secret"          # openssl rand -base64 32

# ─── Supabase (Storage + DB) ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ─── Payments ───────────────────────────────────────────────────────────────
# Platform Razorpay account (PLATFORM_COLLECT: subscriptions, product orders
# where CreatorStore is merchant of record).
RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxx"
# Public key handed to the browser for PLATFORM_COLLECT checkout (checkout.actions).
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_live_xxxxxxxxxxxx"
# Secret used to verify X-Razorpay-Signature on /api/webhooks/razorpay.
# REQUIRED in production — the webhook fails closed (500) without it.
# Configure the SAME secret in the Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET="your-random-webhook-secret"
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"   # optional (future)

# ─── Social APIs (Platform-level fallback keys) ─────────────────────────────
YOUTUBE_API_KEY="your-youtube-api-key"
INSTAGRAM_ACCESS_TOKEN="your-instagram-access-token"
TWITCH_CLIENT_ID="your-twitch-client-id"
TWITCH_CLIENT_SECRET="your-twitch-client-secret"

# ─── Vercel (Custom Domain Provisioning) ────────────────────────────────────
VERCEL_API_TOKEN="your-vercel-api-token"           # Generate in Vercel Dashboard → Settings → Tokens
VERCEL_PROJECT_ID="prj_xxxxxxxxxxxxxxxxxxxx"       # From Vercel Dashboard → Project Settings

# ─── MCP Tooling (RCCF-TOOLING-01) ──────────────────────────────────────────
# OpenCode reads these from the shell/user environment at startup via
# {env:VARIABLE} interpolation in opencode.json. Never commit real values;
# set them as user-level environment variables, then restart OpenCode.
CONTEXT7_API_KEY=""                  # optional; get free at context7.com/dashboard (higher rate limits)
SUPABASE_PROJECT_REF=""              # your Supabase project ref, e.g. abcdefghijkl (from project Settings)
GITHUB_PERSONAL_ACCESS_TOKEN=""      # fine-grained PAT, read-only scopes; github.com/settings/tokens
