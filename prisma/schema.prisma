generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  AGENCY_ADMIN
  AGENCY_STAFF
  ADMIN
  /// IMPLEMENTATION-41: view-only platform roles (no mutations).
  SUPPORT
  READ_ONLY
}

enum AgencyStatus {
  ACTIVE
  TRIAL
  SUSPENDED
  EXPIRED
}

enum WorkspaceType {
  TENANT
  AGENCY
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum WorkspaceStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum RefundStatus {
  NONE
  PENDING
  PARTIAL
  REFUNDED
  FAILED
}

model Tenant {
  id                    String    @id @default(uuid()) @db.Uuid
  name                  String
  subdomain             String    @unique
  customDomain          String?
  razorpayAccountId     String?   @unique
  razorpaySetupComplete Boolean   @default(false)
  youtubeChannelId      String?
  twitchChannelId       String?
  youtubeApiKey         String?
  instagramApiKey       String?
  instagramAccessToken  String?   @db.Text
  instagramRefreshToken String?   @db.Text
  instagramTokenExpiry  DateTime?
  twitchAccessToken     String?   @db.Text
  twitchRefreshToken    String?   @db.Text
  twitchTokenExpiry     DateTime?
  /// @deprecated RCCF-10: legacy FK to `Theme` table — Website.themePackageId is canonical.
  /// Tenant.themeId is never read by storefront/builder/publish. Retained for migration safety; removal requires data migration.
  themeId               String?   @db.Uuid
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  theme                 Theme?                 @relation(fields: [themeId], references: [id])
  agencyTenant          AgencyTenant?
  workspace             Workspace?
  users                 User[]
  products              Product[]
  affiliateLinks        AffiliateLink[]
  galleryImages         GalleryImage[]
  timelineEvents        TimelineEvent[]
  games                 Game[]
  settings              Setting[]
  contactSubmissions    ContactSubmission[]
  newsletterSubscribers NewsletterSubscriber[]
  subscription          Subscription?
  productOrders         ProductOrder[]
  paymentAccounts       PaymentAccount[]
  socialStats           SocialStats[]
  auditLogs             AuditLog[]
  contentFeedItems      ContentFeedItem[]
  assets                Asset[]
  assetReferences       AssetReference[]
  designThemes          DesignTheme[]
  offerings             Offering[]
  purchases             Purchase[]
  workflows             Workflow[]
  workflowExecutions    WorkflowExecution[]
  website               Website?
  clientAssignments     ClientAssignment[]
  bookings              Booking[]

  @@index([customDomain])
  @@index([createdAt])
}

/// One Website per Tenant — the aggregate root for storefront content.
/// Replaces the implicit website stored across Setting rows.
model Website {
  id             String   @id @default(uuid()) @db.Uuid
  tenantId       String   @unique @db.Uuid
  themePackageId String   @default("neon-dark")
  themeColors    Json     @default("{}")
  themeFonts     Json     @default("{}")
  themeConfig    Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  brand         Brand?
  publishStatus PublishStatus?
  pages         Page[]
}

/// Brand identity — replaces brand_config + influencer_data settings.
model Brand {
  id            String  @id @default(uuid()) @db.Uuid
  websiteId     String  @unique @db.Uuid
  name          String
  tagline       String  @default("")
  bio           String  @default("")
  avatarUrl     String?
  bannerUrl     String?
  avatarAssetId String? @db.Uuid
  bannerAssetId String? @db.Uuid
  socialLinks   Json    @default("[]")

  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
}

/// Publish lifecycle — replaces demo_metadata setting.
model PublishStatus {
  id          String    @id @default(uuid()) @db.Uuid
  websiteId   String    @unique @db.Uuid
  state       String    @default("draft") // "draft" | "preview" | "live" | "archived"
  liveVersion Int?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  website   Website           @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  snapshots PublishSnapshot[]

  @@index([state])
}

/// Immutable snapshot of website state at the time of publishing.
/// Enables rollback, preview, and version history.
model PublishSnapshot {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  version   Int
  state     String // "live" | "preview" | "archived"
  snapshot  Json // full copy of pages + sections + blocks + theme
  createdAt DateTime @default(now())

  publishStatus PublishStatus @relation(fields: [websiteId], references: [websiteId], onDelete: Cascade, map: "PublishSnapshot_websiteId_fkey")

  @@unique([websiteId, version])
}

/// @deprecated RCCF-10: legacy Theme table — Website.themePackageId/themeColors/themeFonts/themeConfig is canonical.
/// No runtime reads Tenant.themeId or WebsiteAgency.defaultThemeId. Retained for migration safety; removal requires data migration
/// (verify all references, migrations, admin paths, scripts, seeds, APIs) — do not drop in this RCCF.
model Theme {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @unique
  primaryColor    String   @default("#2D1B69")
  secondaryColor  String   @default("#00f5ff")
  accentColor     String   @default("#ff00e5")
  backgroundColor String   @default("#09090b")
  textColor       String   @default("#ffffff")
  fontFamily      String   @default("Inter")
  borderRadius    String   @default("8px")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenants        Tenant[]
  agencyDefaults WebsiteAgency[] @relation("DefaultTheme")
}

/// @deprecated Use BillingSubscription (v2) instead.
/// Legacy per-tenant subscription model.
/// Slated for removal after all consumers migrate to BillingSubscription.
model Subscription {
  id                     String    @id @default(uuid()) @db.Uuid
  tenantId               String    @unique @db.Uuid
  razorpaySubscriptionId String?
  status                 String    @default("FREE")
  plan                   String    @default("STARTER")
  currentPeriodEnd       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model WebsiteAgency {
  id                    String       @id @default(uuid()) @db.Uuid
  name                  String
  subdomain             String       @unique
  customDomain          String?
  razorpayAccountId     String?      @unique
  razorpaySetupComplete Boolean      @default(false)
  defaultThemeId        String?      @db.Uuid
  platformFeePercent    Float        @default(0)
  status                AgencyStatus @default(TRIAL)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  defaultTheme Theme?         @relation("DefaultTheme", fields: [defaultThemeId], references: [id])
  workspace    Workspace?
  users        User[]
  tenants      AgencyTenant[]
  auditLogs    AuditLog[]
}

model AgencyTenant {
  id                     String   @id @default(uuid()) @db.Uuid
  agencyId               String   @db.Uuid
  tenantId               String   @unique @db.Uuid
  /// IMPLEMENTATION-41: the creator's TENANT workspace (single creator workspace).
  workspaceId            String?  @db.Uuid
  revSharePercent        Float    @default(20)
  productRevSharePercent Float    @default(10)
  canEditTheme           Boolean  @default(true)
  canEditProducts        Boolean  @default(true)
  canEditGallery         Boolean  @default(true)
  canEditLinks           Boolean  @default(true)
  canEditMilestones      Boolean  @default(true)
  canEditSettings        Boolean  @default(false)
  status                 String   @default("ACTIVE")
  /// RCCF-42: set when the agency↔creator relationship is offboarded (status → REVOKED).
  offboardedAt           DateTime?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  agency    WebsiteAgency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workspace Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([agencyId])
}

/// RCCF-IMPLEMENTATION-74 — the creator's canonical payment account for
/// DIRECT_CREATOR commerce. One per (tenant, provider). Sensitive fields are encrypted
/// (AES-256-GCM via src/lib/crypto). CreatorStore is never in the money flow.
/// RCCF-LAUNCH-12 — multi-provider: allow Razorpay + Stripe etc. per creator; only
/// one `isActive` per tenant is the storefront receiving account (verified, ready).
model PaymentAccount {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @db.Uuid
  provider              String    @default("razorpay") // razorpay | stripe | phonepe | cashfree | payu | manual
  displayName           String?
  accountHolderName     String?
  merchantName          String?
  upiId                 String?
  bankAccountName       String?
  bankAccountNumber     String? // encrypted
  ifsc                  String?
  settlementMode        String    @default("upi") // upi | bank
  status                String    @default("pending") // pending | active | disconnected
  verificationStatus    String    @default("unverified") // unverified | pending | verified | failed
  capabilities          Json      @default("{}") // { products: true, services: true, ... }
  providerKeyId         String? // encrypted (creator's own Razorpay key / generic)
  providerKeySecret     String? // encrypted (creator's own Razorpay secret / generic)
  providerAccountId     String? // Stripe acct_xxx or Razorpay linked account id
  isActive              Boolean   @default(false) // active storefront provider for this tenant
  lastVerifiedAt        DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, provider])
  @@index([tenantId, isActive])
  @@index([provider])
  @@index([status])
}

/// ⛔️ DOMAIN FROZEN after Phase 2a — no schema changes without Architecture Review.
/// Workspace is the single aggregate root for billable, member-owned contexts.
model Workspace {
  id                  String          @id @default(uuid()) @db.Uuid
  type                WorkspaceType
  name                String
  slug                String          @unique
  status              WorkspaceStatus @default(ACTIVE)
  isFreelancer        Boolean         @default(false)
  locale              String          @default("en-IN")
  timezone            String          @default("Asia/Kolkata")
  currency            String          @default("INR")
  /// @deprecated legacy — use Setting `onboarding_completed` / `guidance_*` localStorage (RCCF-LAUNCH-05).
  /// Retained for migration safety; no new code should read/write this field.
  onboardingCompleted Boolean         @default(false)
  metadata            Json            @default("{}")
  tenantId            String?         @unique @db.Uuid
  agencyId            String?         @unique @db.Uuid
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  tenant              Tenant?              @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  agency              WebsiteAgency?       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  members             WorkspaceMember[]
  clientAssignments   ClientAssignment[]
  agencyTenants       AgencyTenant[]
  billingSubscription BillingSubscription?
  billingEvents       BillingEvent[]
  billingInvoices     BillingInvoice[]

  @@index([type])
  @@index([status])
}

model WorkspaceMember {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole
  status      String        @default("ACTIVE")
  invitedAt   DateTime      @default(now())
  joinedAt    DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

/// Partner team invitations (RCCF-53) — single-use, expiring, workspace/agency
/// scoped. Kept separate from Creator invitations (creator_invite Setting) so
/// Creator onboarding and Partner team membership never share an authorization
/// path. The token is the sole authority for invitation identity; agency,
/// workspace and role are derived server-side from the stored row.
model AgencyTeamInvitation {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  agencyId    String   @db.Uuid
  email       String
  /// Target application role (AGENCY_STAFF | AGENCY_ADMIN) — derived on accept.
  role        String
  token       String   @unique
  /// pending | accepted | revoked
  status      String   @default("pending")
  expiresAt   DateTime
  invitedById String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([workspaceId])
  @@index([email])
}

/// RCCF-61 — Agency capacity add-on (additional managed client websites).
/// A recurring internal entitlement: quantity × PARTNER_ADDON_UNIT_PRICE_INR
/// adds capacity beyond the plan's included max_clients. The agency identity,
/// quantity and price are server-derived — never client-supplied. Idempotent
/// via (agencyId, idempotencyKey); cancellation is non-destructive (ACTIVE →
/// CANCELLED) so historical billing records are preserved.
model AgencyCapacityAddon {
  id             String   @id @default(uuid()) @db.Uuid
  agencyId       String   @db.Uuid
  quantity       Int
  unitPriceInr   Int
  status         String   @default("ACTIVE") // ACTIVE | CANCELLED
  idempotencyKey String
  createdAt      DateTime @default(now())
  cancelledAt    DateTime?

  @@unique([agencyId, idempotencyKey])
  @@index([agencyId, status])
}

/// Client assignments link workspace members to tenants (clients).
/// Replaces the legacy Setting JSON storage for client assignments.
/// Created in v1.2.1 — see docs/v1.2.1-engineering-plan.md
model ClientAssignment {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  tenantId    String   @db.Uuid
  userId      String   @db.Uuid
  role        String // account_manager | designer | developer | content_editor | support
  assignedAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, tenantId, userId])
  @@index([workspaceId, tenantId])
}

/// RCCF-TRACK-02 — Communication Runtime. In-app notifications.
model Notification {
  id         String   @id @default(uuid()) @db.Uuid
  audience   String   // "creator" | "agency" | "super_admin"
  recipientId String  // tenantId | agencyId | "system"
  category   String   // commerce | orders | payments | builder | website | recommendations | business_health | billing | security | marketing | customer_success | system
  title      String
  body       String?
  priority   String   @default("medium") // low | medium | high
  channel    String   @default("in_app") // in_app | email | alert
  data       Json?
  readAt     DateTime?
  archivedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([audience, recipientId, createdAt])
  @@index([audience, recipientId, readAt])
  @@index([category])
}

/// RCCF-TRACK-02 — per-category channel preferences.
model NotificationPreference {
  id         String  @id @default(uuid()) @db.Uuid
  audience   String
  recipientId String
  category   String
  channel    String  @default("in_app") // email | in_app | both | none
  updatedAt  DateTime @updatedAt

  @@unique([audience, recipientId, category])
}

/// RCCF-TRACK-02 — auditable delivery history + retry queue.
model CommunicationLog {
  id         String   @id @default(uuid()) @db.Uuid
  templateId String
  recipient  String
  channel    String   // email | in_app | alert | sms | whatsapp | push
  status     String   @default("queued") // queued | sent | delivered | failed
  provider   String   @default("log") // log | email | in_app | alert
  retries    Int      @default(0)
  maxRetries Int      @default(3)
  error      String?
  payload    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([templateId])
  @@index([recipient])
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @db.Uuid
  agencyId  String?  @db.Uuid
  name      String?
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant            Tenant?            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agency            WebsiteAgency?     @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  workspaceMembers  WorkspaceMember[]
  clientAssignments ClientAssignment[]

  @@index([tenantId])
  @@index([agencyId])
  @@index([role])
}

model Product {
  id             String    @id @default(uuid()) @db.Uuid
  tenantId       String    @db.Uuid
  name           String
  description    String?
  price          Float
  imageUrl       String?
  images         Json?     @default("[]")
  imageAssetId   String?   @db.Uuid
  slug           String?
  // RCCF-IMPLEMENTATION-74: standardized commerce type.
  // digital | physical | course | service | booking | affiliate | donation
  type           String    @default("digital")
  // RCCF-TRACK-01: secure digital delivery — the file/download link the
  // fulfillment runtime proxies behind a signed, expiring token.
  downloadUrl    String?
  // RCCF-66.2: per-product sales mode. ONLINE | WHATSAPP | BOTH — what CTA the
  // storefront renders. Existing products default to ONLINE (additive).
  commerceMode   String    @default("ONLINE")
  status         String    @default("PUBLISHED")
  seoTitle       String?
  seoDescription String?
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  isFeatured     Boolean   @default(false)
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  orders ProductOrder[]
  fulfillments OrderFulfillment[]

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([slug, tenantId])
  @@index([tenantId, status, isActive, order])
}

model ProductOrder {
  id                   String      @id @default(cuid())
  tenantId             String      @db.Uuid
  productId            String      @db.Uuid
  amount               Float
  status               String      @default("PENDING")
  razorpayOrderId      String      @unique
  razorpayPaymentId    String?
  fanEmail             String?
  platformFeePercent   Float       @default(5)
  agencyFeePercent     Float?
  agencyId             String?     @db.Uuid
  routeTransferId      String?
  // RCCF-IMPLEMENTATION-74: order runtime metadata (provider-agnostic).
  commerceStrategy     String?
  provider             String?
  providerReference    String?
  providerMetadata     Json?
  // RCCF-72.18D.2: historical payment account binding + refund state
  paymentAccountId     String?     @db.Uuid
  refundStatus         RefundStatus @default(NONE)
  refundId             String?
  refundAmount         Int?        // cumulative refunded amount in minor units (paise)
  refundedAt           DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  fulfillment  OrderFulfillment?
  shippingAddress ShippingAddress?

  @@index([tenantId])
  @@index([productId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([paymentAccountId])
  @@index([refundStatus])
}

/// RCCF-TRACK-01 — the post-payment fulfillment record for an order.
model OrderFulfillment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @unique
  tenantId       String   @db.Uuid
  productId      String   @db.Uuid
  type           String   @default("digital") // digital | physical | course | service | booking | affiliate | donation
  status         String   @default("pending") // pending | preparing | packed | shipped | delivered | ready | completed | cancelled | returned | accepted
  trackingNumber String?
  courier        String?
  carrierNotes   String?
  shippedAt      DateTime?
  deliveredAt    DateTime?
  // Secure digital delivery (signed, expiring token).
  downloadUrl    String?
  downloadToken  String?  @unique
  downloadExpiresAt DateTime?
  downloadLimit  Int      @default(5)
  downloadCount  Int      @default(0)
  timeline       Json     @default("[]")
  metadata       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

/// RCCF-TRACK-01 — shipping address for physical orders.
model ShippingAddress {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @unique
  tenantId     String  @db.Uuid
  name         String?
  phone        String?
  email        String?
  line1        String?
  line2        String?
  city         String?
  state        String?
  pin          String?
  country      String?
  instructions String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  order ProductOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model AffiliateLink {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  title        String
  url          String
  imageUrl     String?
  imageAssetId String?  @db.Uuid
  order        Int      @default(0)
  clicks       Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model ContactSubmission {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  email     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model NewsletterSubscriber {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  email     String
  name      String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
}

model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  key       String
  value     Json
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([key])
}

model GalleryImage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  title       String
  description String?
  altText     String?
  imageUrl    String
  mediaType   String    @default("image")
  videoUrl    String?
  assetId     String?   @db.Uuid
  width       Int?
  height      Int?
  fileSize    Int?
  category    String    @default("general")
  tags        String?
  status      String    @default("PUBLISHED")
  isFeatured  Boolean   @default(false)
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([category])
  @@index([tenantId, status, isActive, order])
}

model TimelineEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  year         String
  title        String
  description  String
  imageUrl     String?
  imageAssetId String?  @db.Uuid
  stats        String?
  order        Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Game {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  logoUrl     String?
  logoAssetId String?  @db.Uuid
  description String?
  genre       String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model SocialStats {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  platform  String
  followers Int      @default(0)
  views     Int      @default(0)
  posts     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform])
}

model AuditLog {
  id        String    @id @default(uuid()) @db.Uuid
  /// Tenant-scoped events (creator/platform). NULL for agency-scoped events.
  tenantId  String?   @db.Uuid
  /// RCCF-55 — agency-scoped events (partner team lifecycle). NULL for tenant events.
  agencyId  String?   @db.Uuid
  action    String
  metadata  Json      @default("{}")
  createdAt DateTime  @default(now())

  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  agency WebsiteAgency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([agencyId, createdAt])
}

model ContentFeedItem {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  platform         String // "instagram" | "twitch" | "youtube"
  mediaType        String // "image" | "video"
  url              String   @db.Text
  thumbnailUrl     String?  @db.Text
  thumbnailAssetId String?  @db.Uuid
  caption          String?  @db.Text
  permalink        String?  @db.Text
  pinned           Boolean  @default(false)
  hidden           Boolean  @default(false)
  externalId       String? // platform's native post ID (dedup key)
  order            Int      @default(0)
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, externalId])
  @@index([tenantId, pinned, hidden, order])
}

// ──────────────────────────────────────────────────────────────────────────────
// Builder — Pages, Sections, Blocks (persisted workspace state)
// ──────────────────────────────────────────────────────────────────────────────

/// A page within a website's builder workspace.
model Page {
  id        String   @id @default(uuid()) @db.Uuid
  websiteId String   @db.Uuid
  name      String
  slug      String
  order     Int      @default(0)
  isHome    Boolean  @default(false)
  theme     String   @default("default")
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  website  Website   @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  sections Section[]

  @@unique([websiteId, slug])
}

/// A section within a page — holds blocks.
model Section {
  id        String   @id @default(uuid()) @db.Uuid
  pageId    String   @db.Uuid
  name      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  locked    Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  page   Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  blocks Block[]

  @@index([pageId])
}

/// A content block within a section — the atomic unit a creator edits.
model Block {
  id        String   @id @default(uuid()) @db.Uuid
  sectionId String   @db.Uuid
  moduleId  String
  parentId  String?
  order     Int      @default(0)
  visible   Boolean  @default(true)
  locked    Boolean  @default(false)
  config    Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Creator Provisioning — State Machine + Event Log
// ──────────────────────────────────────────────────────────────────────────────

/// One row per provisioning run — tracks overall status and current step.
model CreatorProvisionRun {
  id             String    @id @default(uuid()) @db.Uuid
  creatorName    String
  sourceUrl      String?
  sourcePlatform String?
  tenantId       String?   @db.Uuid
  tenantSlug     String?
  status         String    @default("PENDING")
  currentStep    String    @default("IMPORT_REQUESTED")
  error          String?
  startedAt      DateTime  @default(now())
  completedAt    DateTime?
  durationMs     Int?
  metadata       Json      @default("{}")

  events CreatorProvisionEvent[]

  @@index([status])
  @@index([startedAt])
  @@index([tenantId])
}

/// Append-only event log — every state transition is recorded here.
model CreatorProvisionEvent {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  step      String
  event     String // "started" | "completed" | "failed"
  message   String?
  timestamp DateTime @default(now())

  run CreatorProvisionRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, timestamp])
}

// ──────────────────────────────────────────────────────────────────────────────
// Generation Session — first-class resource for every creator generation
// ──────────────────────────────────────────────────────────────────────────────

/// Immutable event log for a GenerationSession.
model GenerationSessionEvent {
  id        String   @id @default(uuid()) @db.Uuid
  sessionId String   @db.Uuid
  type      String // stage_started | stage_completed | stage_failed | status_changed | progress_updated | error_occurred | warning_added | retry_initiated | workflow_linked
  data      Json     @default("{}")
  timestamp DateTime @default(now())

  session GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, timestamp])
}

/// Per-stage tracking within a GenerationSession.
model GenerationSessionStage {
  id          String    @id @default(uuid()) @db.Uuid
  sessionId   String    @db.Uuid
  type        String // import_profile | knowledge_intelligence | persona_detection | planning_context | experience_planning | composition | artifact_generation | provisioning | publishing | golden_validation
  status      String // pending | running | completed | skipped | failed
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?
  error       String?

  session GenerationSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, type])
}

/// Every creator generation is a first-class resource with lifecycle, progress, and history.
model GenerationSession {
  id                    String    @id @default(uuid()) @db.Uuid
  workspaceId           String?   @db.Uuid
  creatorId             String?   @db.Uuid
  creatorName           String
  sourceUrl             String?
  platform              String?
  status                String    @default("created") // created | queued | running | publishing | completed | failed | cancelled | timed_out | retrying
  currentStage          String?
  progressPercent       Int       @default(0)
  maxRetries            Int       @default(3)
  retryCount            Int       @default(0)
  workflowId            String?   @db.Uuid
  evaluationScore       Float?
  goldenValidationScore Float?
  artifactVersion       Int?
  correlationId         String?
  storefrontUrl         String?
  builderUrl            String?
  dashboardUrl          String?
  error                 String?
  warnings              Json      @default("[]")
  startedAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  completedAt           DateTime?

  stages  GenerationSessionStage[]
  history GenerationSessionEvent[]

  @@index([workspaceId])
  @@index([status])
  @@index([creatorId])
  @@index([status, updatedAt])
  @@index([correlationId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Billing v2 — Phase 1 Foundation (additive — legacy tables preserved)
// ──────────────────────────────────────────────────────────────────────────────

/// Billing account — single billable entity for creators and agencies.
/// Replaces the polymorphic subscription pattern.
model BillingAccount {
  id          String   @id @default(uuid()) @db.Uuid
  accountType String // "tenant" | "agency"
  accountId   String   @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions BillingSubscription[]

  @@unique([accountType, accountId])
}

/// Immutable plan catalog entry.
/// Plans are versioned — never edited after customers subscribe.
model BillingPlan {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique // "creator_free", "creator_pro", "agency_starter", etc.
  family    String // "creator" | "agency"
  name      String
  price     Float    @default(0)
  currency  String   @default("INR")
  cycle     String   @default("monthly") // "monthly" | "annual"
  status    String   @default("ACTIVE") // "ACTIVE" | "DEPRECATED" | "GRANDFATHERED"
  version   Int      @default(1)
  createdAt DateTime @default(now())
  // RCCF-IMPLEMENTATION-70: registry-driven marketing surface mirrored to the
  // DB so the Super Admin can propagate plan changes without a redeploy.
  marketing Json?
  // RCCF-IMPLEMENTATION-71: the runtime config — capabilities, feature
  // overrides, marketing, pricing (+ schedule) — edited live by Super Admin.
  runtimeConfig Json?
  gracePeriodDays Int? @default(0)
  effectiveAt DateTime?

  features      BillingPlanFeature[]
  subscriptions BillingSubscription[]
  pricingVersions PlanPricingVersion[]
}

/// RCCF-IMPLEMENTATION-71 — version history for every pricing change. Enables
/// rollback + full audit (who changed, when, what).
model PlanPricingVersion {
  id         String   @id @default(uuid()) @db.Uuid
  planCode   String
  planId     String?  @db.Uuid
  payload    Json
  author     String?
  changeNote String?
  createdAt  DateTime @default(now())

  plan BillingPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([planCode, createdAt])
}

/// RCCF-IMPLEMENTATION-71 Phase 10 — coupon foundation (architecture only; not
/// yet wired into checkout).
model Coupon {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  label           String
  description     String?
  discountPercent Int?
  discountAmount  Float?
  scope           String   @default("creator") // "creator" | "partner" | "platform"
  planCodes       String[] @default([]) // plans the coupon applies to (empty = all in scope)
  maxUses         Int?
  usedCount       Int      @default(0)
  active          Boolean  @default(true)
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
}

/// RCCF-IMPLEMENTATION-71 Phase 11 — launch programs (Early Adopter, Founding
/// Creator/Agency, Lifetime, Invite-only) stored canonically.
model LaunchProgram {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  name            String
  description     String?
  discountPercent Int?
  discountAmount  Float?
  scope           String   @default("platform") // "creator" | "partner" | "platform"
  planCodes       String[] @default([]) // plans the program applies to
  inviteOnly      Boolean  @default(false)
  active          Boolean  @default(true)
  maxEnrollees    Int?
  enrolledCount   Int      @default(0)
  createdAt       DateTime @default(now())
}

/// Typed feature definitions.
/// New features are added to this table, never edited.
model BillingFeature {
  id          String @id @default(uuid()) @db.Uuid
  key         String @unique // "max_products", "custom_domain", "max_clients", etc.
  description String
  valueType   String @default("integer") // "integer" | "boolean" | "string"

  planFeatures BillingPlanFeature[]
}

/// Join table with typed feature values.
/// JSON reserved for future complex configurations only.
model BillingPlanFeature {
  planId    String   @db.Uuid
  featureId String   @db.Uuid
  intValue  Int?
  boolValue Boolean?
  strValue  String?

  plan    BillingPlan    @relation(fields: [planId], references: [id])
  feature BillingFeature @relation(fields: [featureId], references: [id])

  @@id([planId, featureId])
}

/// Unified subscription — one table for all billing.
/// Separation: Payment → Billing Event → Subscription State → Feature Gate
model BillingSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  accountId          String    @db.Uuid
  workspaceId        String?   @unique @db.Uuid
  planId             String    @db.Uuid
  status             String    @default("ACTIVE") // "TRIALING" | "ACTIVE" | "PAST_DUE" | "CANCELLED" | "EXPIRED"
  trialEndsAt        DateTime?
  renewsAt           DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  account   BillingAccount @relation(fields: [accountId], references: [id])
  plan      BillingPlan    @relation(fields: [planId], references: [id])
  workspace Workspace?     @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([planId])
  @@index([planId, status])
}

/// Immutable billing event log. Append-only, never edited.
/// Provides idempotency key for webhook processing.
model BillingEvent {
  id             String   @id @default(uuid()) @db.Uuid
  accountId      String   @db.Uuid
  workspaceId    String?  @db.Uuid
  type           String // SUBSCRIPTION_CREATED, CHECKOUT_STARTED, PAYMENT_SUCCEEDED, PAYMENT_FAILED, SUBSCRIPTION_ACTIVATED, SUBSCRIPTION_RENEWED, SUBSCRIPTION_CANCELLED, REFUND_CREATED, REFUND_COMPLETED, INVOICE_ISSUED, INVOICE_PAID
  idempotencyKey String?  @unique // Prevents duplicate webhook processing
  payload        Json?
  createdAt      DateTime @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([accountId])
  @@index([workspaceId])
  @@index([type])
  @@index([type, createdAt])
}

/// Platform alert record (IMPLEMENTATION-40) — durable alert state replacing
/// runtime-only alerts. Status: ACTIVE / RESOLVED / DISMISSED.
model AlertRecord {
  id             String    @id @default(uuid()) @db.Uuid
  level          String // INFO | WARNING | CRITICAL
  status         String    @default("ACTIVE") // ACTIVE | RESOLVED | DISMISSED
  title          String
  message        String?
  source         String // health | billing | publishing | provisioning | jobs | system
  service        String?
  tenantId       String?   @db.Uuid
  workspaceId    String?   @db.Uuid
  relatedJobId   String?   @db.Uuid
  metadata       Json?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  dismissedAt    DateTime?
  acknowledgedBy String?

  @@index([level])
  @@index([status])
  @@index([source])
  @@index([createdAt])
}

/// Platform job record (IMPLEMENTATION-40) — durable job runs replacing the
/// in-process-only scheduler view. Status: QUEUED | RUNNING | SUCCEEDED | FAILED | CANCELLED.
model JobRecord {
  id          String    @id @default(uuid()) @db.Uuid
  type        String // publishing | generation | cleanup | webhook | storage | cron
  name        String
  status      String    @default("QUEUED")
  scheduledAt DateTime  @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?
  durationMs  Int?
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  error       String?
  triggeredBy String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

/// Financial source of truth. Immutable after payment.
/// Created before checkout, finalized after payment success.
model BillingInvoice {
  id                String    @id @default(uuid()) @db.Uuid
  accountId         String    @db.Uuid
  workspaceId       String?   @db.Uuid
  subscriptionId    String?   @db.Uuid
  planCode          String
  planVersion       Int       @default(1)
  amount            Float
  taxAmount         Float     @default(0)
  currency          String    @default("INR")
  status            String    @default("PENDING")
  lineItems         Json?     @default("[]")
  provider          String?
  providerReference String?
  invoiceUrl        String?
  issuedAt          DateTime  @default(now())
  paidAt            DateTime?
  dueAt             DateTime?
  metadata          Json?
  createdAt         DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([status])
  @@index([dueAt])
  @@index([workspaceId, issuedAt])
  @@index([status, issuedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Revenue Management — Commercial Configuration (BILLING-02A)
// ──────────────────────────────────────────────────────────────────────────────

/// Platform-wide commercial defaults. Only one ACTIVE record at a time.
model RevenueConfiguration {
  id               String    @id @default(uuid()) @db.Uuid
  status           String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  defaultCurrency  String    @default("INR")
  defaultTrialDays Int       @default(14)
  gracePeriodDays  Int       @default(7)
  invoicePrefix    String    @default("INV")
  autoRenew        Boolean   @default(true)
  refundWindowDays Int       @default(30)
  prorationEnabled Boolean   @default(true)
  effectiveFrom    DateTime  @default(now())
  effectiveTo      DateTime?
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

/// Commercial pricing for capability plans. Prices only — NOT entitlements.
model CommercialPricing {
  id            String    @id @default(uuid()) @db.Uuid
  planCode      String // matches capability plan code (e.g. "creator_pro")
  workspaceType String // "creator" | "agency"
  monthlyPrice  Float     @default(0)
  yearlyPrice   Float     @default(0)
  currency      String    @default("INR")
  status        String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([planCode, version])
  @@index([planCode, status])
}

/// Commission and revenue sharing policies.
model CommissionPolicy {
  id                  String    @id @default(uuid()) @db.Uuid
  status              String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  agencyClientPercent Float     @default(20)
  platformPercent     Float     @default(10)
  referralPercent     Float     @default(5)
  creatorDefaultShare Float     @default(70)
  agencyDefaultShare  Float     @default(30)
  effectiveFrom       DateTime  @default(now())
  effectiveTo         DateTime?
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

/// Loyalty commission tiers — RCCF-IMPLEMENTATION-75. Agencies earn an
/// automatic recurring share of creator subscriptions that scales with the
/// number of ACTIVE clients (live BillingSubscription). Config data: the
/// runtime resolves the tier by active-client count, so rate/threshold
/// changes are a data change, not a redeploy.
model LoyaltyTier {
  id                String    @id @default(uuid()) @db.Uuid
  status            String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  name              String
  minActiveClients  Int
  maxActiveClients  Int?
  commissionPercent Int       // partner share % (30 | 40 | 50)
  effectiveFrom     DateTime  @default(now())
  effectiveTo       DateTime?
  priority          Int       @default(100)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status, effectiveFrom, effectiveTo])
}

/// Global billing defaults and operational settings.
model BillingConfiguration {
  id                 String    @id @default(uuid()) @db.Uuid
  status             String    @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  taxMode            String    @default("exclusive")
  cancellationPolicy String    @default("immediate")
  defaultRegion      String    @default("IN")
  effectiveFrom      DateTime  @default(now())
  effectiveTo        DateTime?
  version            Int       @default(1)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

// ──────────────────────────────────────────────────────────────────────────────
// Creator Intelligence Engine — Provider Accounts, Profiles, AI Analysis
// ──────────────────────────────────────────────────────────────────────────────

/// Normalized provider account — one per external creator source.
model ProviderAccount {
  id          String    @id @default(uuid()) @db.Uuid
  provider    String // "youtube" | "instagram" | "twitch" | "tiktok"
  externalId  String
  handle      String?
  name        String?
  profileData Json      @default("{}")
  fetchedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fetchLogs ProviderFetchLog[]

  @@unique([provider, externalId])
  @@index([provider])
  @@index([handle])
}

/// Log of every provider API fetch — used for debugging and quota tracking.
model ProviderFetchLog {
  id         String   @id @default(uuid()) @db.Uuid
  provider   String // "youtube" | "instagram" | ...
  accountId  String?  @db.Uuid
  endpoint   String
  quotaUnits Int      @default(1)
  latencyMs  Int      @default(0)
  status     String // "success" | "error" | "cached"
  cached     Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  account ProviderAccount? @relation(fields: [accountId], references: [id])

  @@index([provider, createdAt])
  @@index([accountId])
}

/// Daily YouTube API quota usage tracking.
model YouTubeQuotaUsage {
  id           String   @id @default(uuid()) @db.Uuid
  date         DateTime
  unitsUsed    Int      @default(0)
  calls        Int      @default(0)
  failures     Int      @default(0)
  avgLatencyMs Float    @default(0)
  createdAt    DateTime @default(now())

  @@unique([date])
}

/// Normalized creator profile — output of any provider, input to AI.
model CreatorProfile {
  id            String   @id @default(uuid()) @db.Uuid
  name          String?
  description   String?
  avatarUrl     String?
  bannerUrl     String?
  followers     Int      @default(0)
  videoCount    Int      @default(0)
  viewCount     BigInt   @default(0)
  country       String?
  platform      String // "youtube" | "instagram" | ...
  handle        String?
  externalId    String?
  socialLinks   Json     @default("[]")
  latestContent Json     @default("[]")
  categories    Json     @default("[]")
  keywords      Json     @default("[]")
  language      String?
  rawResponse   Json? // stored for debugging
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  intelligence CreatorIntelligence?

  @@index([platform, handle])
}

/// AI-derived analysis of a CreatorProfile.
model CreatorIntelligence {
  id                  String   @id @default(uuid()) @db.Uuid
  profileId           String   @unique @db.Uuid
  niche               String
  subNiche            String?
  audience            String?
  brandPersonality    String?
  brandTone           String?
  visualStyle         String?
  contentStyle        String?
  websiteGoal         String?
  monetization        String?
  recommendedTheme    String?
  recommendedTemplate String?
  recommendedSections Json     @default("[]")
  seoKeywords         Json     @default("[]")
  confidence          Float    @default(0)
  reasoning           String?
  model               String   @default("gpt-4")
  createdAt           DateTime @default(now())

  profile CreatorProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

/// Aggregate root for every creator onboarding — traceable import lifecycle.
model CreatorImport {
  id                    String    @id @default(uuid()) @db.Uuid
  creatorName           String
  sourceUrl             String?
  sourcePlatform        String?
  provider              String?
  providerAccountId     String?   @db.Uuid
  creatorProfileId      String?   @db.Uuid
  creatorIntelligenceId String?   @db.Uuid
  tenantId              String?   @db.Uuid
  websiteId             String?   @db.Uuid
  status                String    @default("STARTED") // STARTED | FETCHING | ANALYZING | GENERATING | COMPLETED | FAILED
  cacheHit              Boolean   @default(false)
  durationMs            Int?
  warnings              Json      @default("[]")
  errors                Json      @default("[]")
  correlationId         String?
  startedAt             DateTime  @default(now())
  completedAt           DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdBy             String? // userId who triggered the import

  @@index([status])
  @@index([createdAt])
  @@index([provider])
  @@index([creatorName])
}

// ──────────────────────────────────────────────────────────────────────────────
// Media Library — Asset Management
// ──────────────────────────────────────────────────────────────────────────────

/// Every uploaded asset (image, video, file) — first-class domain object.
model Asset {
  id               String   @id @default(uuid()) @db.Uuid
  tenantId         String   @db.Uuid
  filename         String
  originalFilename String
  mimeType         String
  size             Int      @default(0)
  width            Int?
  height           Int?
  duration         Int? // Duration in seconds (for video/audio)
  checksum         String?
  blurHash         String? // Blur placeholder data URL
  dominantColor    String? // Hex color string (e.g. "#18181b")
  storageProvider  String   @default("local")
  storageKey       String
  publicUrl        String?
  thumbnailUrl     String?
  mediumUrl        String?
  largeUrl         String?
  altText          String?
  referenceCount   Int      @default(0)
  status           String   @default("ACTIVE") // ACTIVE | DELETED
  processingStatus String   @default("PENDING") // PENDING | QUEUED | PROCESSING | READY | FAILED
  processingError  String? // Error message if processing failed
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  references AssetReference[]

  @@index([checksum])
  @@index([mimeType])
  @@index([status])
  @@index([tenantId, createdAt])
}

/// Tracks which business entity references which asset.
model AssetReference {
  id         String   @id @default(uuid()) @db.Uuid
  assetId    String   @db.Uuid
  tenantId   String   @db.Uuid
  entityType String // e.g. "product", "gallery", "hero", "profile", "timeline", "game"
  entityId   String // UUID of the business entity
  field      String? // e.g. "imageUrl", "avatarUrl", "bannerUrl", "posterUrl", "videoUrl"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  asset  Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([assetId, entityType, entityId, field])
  @@index([assetId])
  @@index([tenantId])
  @@index([entityType, entityId])
}

// ──────────────────────────────────────────────────────────────────────────────
// Theme Studio — Design System
// ──────────────────────────────────────────────────────────────────────────────

/// A named theme — collection of design tokens for a tenant.
model DesignTheme {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  mode        String   @default("light") // "light" | "dark" | "auto"
  active      Boolean  @default(false)
  tokens      Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, active])
}

// ──────────────────────────────────────────────────────────────────────────────
// Creator Commerce — Offerings & Purchases
// ──────────────────────────────────────────────────────────────────────────────

/// A monetizable offering — course, digital product, membership, coaching, etc.
model Offering {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  type        String // "course" | "digital_product" | "membership" | "coaching" | "webinar" | "affiliate" | "donation" | "merchandise"
  title       String
  slug        String
  description String?
  status      String   @default("draft") // "draft" | "published" | "archived"
  price       Float    @default(0)
  currency    String   @default("INR")
  // RCCF-67.5 — a Service (type="coaching") is only bookable when the creator
  // explicitly enables this flag. False (default) → display-only.
  bookable    Boolean  @default(false)
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]
  bookings  Booking[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@index([type])
}

/// A purchase transaction — tracks the full lifecycle.
model Purchase {
  id                String    @id @default(uuid()) @db.Uuid
  offeringId        String    @db.Uuid
  tenantId          String    @db.Uuid
  customerEmail     String?
  customerName      String?
  amount            Float     @default(0)
  currency          String    @default("INR")
  status            String    @default("pending") // "pending" | "completed" | "fulfilled" | "refunded" | "cancelled"
  checkoutProvider  String? // "stripe" | "razorpay" | "paddle" | "lemonsqueezy"
  providerSessionId String?
  providerPaymentId String?
  fulfilledAt       DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  offering Offering @relation(fields: [offeringId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([offeringId])
  @@index([tenantId])
  @@index([status])
}

model Booking {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String    @db.Uuid
  // RCCF-67.5 — optional link to the Service/Offering this slot belongs to.
  // Null for standalone bookings created outside a Service.
  offeringId       String?   @db.Uuid
  title            String
  description      String?
  price            Float     @default(0)
  currency         String    @default("INR")
  duration         Int       @default(60)
  slotDate         DateTime
  slotStart        String    @default("09:00")
  slotEnd          String    @default("10:00")
  timezone         String    @default("Asia/Kolkata")
  status           String    @default("pending")
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  notes            String?
  approvalRequired Boolean   @default(true)
  approvedAt       DateTime?
  cancelledAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  offering Offering? @relation(fields: [offeringId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, status])
  @@index([offeringId])
  @@index([slotDate])
}

// ──────────────────────────────────────────────────────────────────────────────
// Workflow & Automation Engine
// ──────────────────────────────────────────────────────────────────────────────

/// A workflow that reacts to an event and executes actions.
model Workflow {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @db.Uuid
  name        String
  description String?
  trigger     String // Event type that activates this workflow
  enabled     Boolean  @default(true)
  actions     Json     @default("[]") // Ordered list of action configurations
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  executions WorkflowExecution[]

  @@index([tenantId])
  @@index([trigger])
  @@index([enabled])
}

/// Immutable execution log for every workflow run.
model WorkflowExecution {
  id          String    @id @default(uuid()) @db.Uuid
  workflowId  String    @db.Uuid
  tenantId    String    @db.Uuid
  trigger     String // Which event triggered this execution
  status      String    @default("pending") // "pending" | "running" | "completed" | "failed"
  actions     Json      @default("[]") // Snapshot of actions at execution time
  results     Json      @default("[]") // Per-action results (success, error, duration)
  retries     Int       @default(0)
  maxRetries  Int       @default(1)
  durationMs  Int?
  error       String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Analytics & Insights Platform
// ──────────────────────────────────────────────────────────────────────────────

/// An analytics event emitted by any domain — immutable, append-only.
model AnalyticsEvent {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @db.Uuid
  source     String
  eventType  String
  entityId   String?
  payload    Json     @default("{}")
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([tenantId, occurredAt])
  @@index([source, eventType])
  @@index([eventType, occurredAt])
  @@index([occurredAt])
  @@index([tenantId, eventType, occurredAt])
}

// ── PLATFORM EVENTS ──────────────────────────────────────────────────────────

model PlatformEvent {
  id            String   @id @default(uuid()) @db.Uuid
  eventType     String
  payload       Json     @default("{}")
  aggregateId   String?
  correlationId String?
  source        String   @default("platform")
  occurredAt    DateTime @default(now())

  @@index([eventType, occurredAt])
  @@index([aggregateId])
  @@index([correlationId])
  @@index([occurredAt])
}

// ── PARTNER ──────────────────────────────────────────────────────────────────

enum PartnerType {
  freelancer
  agency
  enterprise
  marketplace
  affiliate
}

enum PartnerStatus {
  pending
  active
  suspended
  disabled
  invited
  archived
}

model Partner {
  id            String        @id @db.Uuid
  type          PartnerType   @default(agency)
  status        PartnerStatus @default(active)
  businessName  String
  logo          String?
  website       String?
  description   String?
  taxIdentifier String?
  country       String?
  timezone      String?       @default("Asia/Kolkata")
  supportEmail  String?
  contactPerson String?
  socialLinks   Json          @default("{}")
  settings      Json          @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  workspaceAssignments PartnerWorkspaceAssignment[]
  invites              PartnerInvite[]
  members              PartnerMember[]
}

model PartnerMember {
  id        String   @id @default(uuid()) @db.Uuid
  partnerId String   @db.Uuid
  userId    String
  role      String   @default("viewer")
  status    String   @default("active")
  joinedAt  DateTime @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, userId])
}

model PartnerWorkspaceAssignment {
  id            String    @id @default(uuid()) @db.Uuid
  partnerId     String    @db.Uuid
  workspaceId   String    @unique
  workspaceName String
  workspaceSlug String?
  status        String    @default("active")
  reason        String    @default("created")
  assignedBy    String
  assignedAt    DateTime  @default(now())
  transferredAt DateTime?
  removedAt     DateTime?

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
}

model PartnerInvite {
  id         String    @id @default(uuid()) @db.Uuid
  partnerId  String    @db.Uuid
  email      String
  role       String    @default("viewer")
  status     String    @default("pending")
  invitedBy  String
  acceptedBy String?
  acceptedAt DateTime?
  declinedAt DateTime?
  revokedAt  DateTime?
  expiredAt  DateTime?
  expiresAt  DateTime
  message    String?
  createdAt  DateTime  @default(now())

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId, status])
  @@index([email])
}

// ── COMMISSION ───────────────────────────────────────────────────────────────

model CommissionRule {
  id                   String    @id @default(uuid()) @db.Uuid
  type                 String    @default("default")
  status               String    @default("active")
  partnerId            String?   @db.Uuid
  platformSharePercent Int
  partnerSharePercent  Int
  effectiveFrom        DateTime  @default(now())
  effectiveTo          DateTime?
  priority             Int       @default(100)
  label                String
  description          String?
  metadata             Json      @default("{}")
  createdAt            DateTime  @default(now())

  @@index([partnerId])
  @@index([status, effectiveFrom, effectiveTo])
}

model CommissionEntry {
  id              String    @id @default(uuid()) @db.Uuid
  invoiceId       String
  partnerId       String    @db.Uuid
  subscriptionId  String?
  planCode        String
  amount          Float
  platformShare   Float
  partnerShare    Float
  platformPercent Int
  partnerPercent  Int
  entryType       String    @default("commission_created")
  status          String    @default("pending")
  description     String?
  ruleId          String?   @db.Uuid
  parentEntryId   String?   @db.Uuid
  clearedAt       DateTime?
  reversedAt      DateTime?
  audit           Json      @default("{}")
  createdAt       DateTime  @default(now())

  @@index([partnerId, createdAt])
  @@index([invoiceId])
  @@index([status])
  @@index([createdAt])
}

// ── PAYOUT ───────────────────────────────────────────────────────────────────

model PayoutBatch {
  id                String   @id @default(uuid()) @db.Uuid
  partnerId         String   @db.Uuid
  status            String   @default("pending")
  provider          String   @default("manual")
  currency          String   @default("INR")
  total             Float
  fee               Float    @default(0)
  netAmount         Float
  entryCount        Int      @default(1)
  idempotencyKey    String   @unique
  providerReference String?
  bankReference     String?
  failureReason     String?
  audit             Json     @default("{}")
  metadata          Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  reservations PayoutReservation[]

  @@index([partnerId])
  @@index([status])
  @@index([idempotencyKey])
}

model PayoutReservation {
  id                String    @id @default(uuid()) @db.Uuid
  batchId           String    @db.Uuid
  partnerId         String    @db.Uuid
  commissionEntryId String
  amount            Float
  status            String    @default("reserved")
  createdAt         DateTime  @default(now())
  settledAt         DateTime?
  releasedAt        DateTime?

  batch PayoutBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([partnerId])
  @@index([commissionEntryId])
  @@index([status])
}

model Settlement {
  id             String    @id @default(uuid()) @db.Uuid
  partnerId      String    @db.Uuid
  partnerName    String?
  status         String    @default("PENDING")
  provider       String    @default("manual")
  currency       String    @default("INR")
  totalAmount    Float
  feeAmount      Float     @default(0)
  netAmount      Float
  entryCount     Int
  approvedBy     String?
  approvedAt     DateTime?
  processedAt    DateTime?
  paidAt         DateTime?
  transferRef    String?
  transferMethod String?
  notes          String?
  failureReason  String?
  settlementRef  String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items       SettlementItem[]
  attachments SettlementAttachment[]

  @@index([partnerId])
  @@index([status])
}

model SettlementItem {
  id                String   @id @default(uuid()) @db.Uuid
  settlementId      String   @db.Uuid
  commissionEntryId String
  amount            Float
  status            String   @default("pending")
  createdAt         DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  // RCCF-41: one commission entry can belong to at most ONE settlement — a DB
  // unique boundary so two concurrent settlements can never double-reserve it.
  @@unique([commissionEntryId])
  @@index([settlementId])
  @@index([status])
}

model SettlementAttachment {
  id           String   @id @default(uuid()) @db.Uuid
  settlementId String   @db.Uuid
  type         String
  url          String
  filename     String?
  uploadedBy   String?
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@index([settlementId])
}

model PartnerLedger {
  id            String   @id @default(uuid()) @db.Uuid
  partnerId     String   @db.Uuid
  type          String
  amount        Float
  reference     String?
  referenceType String?
  description   String
  settlementId  String?  @db.Uuid
  commissionId  String?
  balanceBefore Float
  balanceAfter  Float
  createdAt     DateTime @default(now())

  @@index([partnerId])
  @@index([type])
  @@index([reference])
  @@index([settlementId])
}

/// RCCF-LAUNCH-10 — agency product commission ledger (canonical order → commission)
/// One row per ProductOrder that is eligible (creator belongs to agency). Idempotent
/// via unique orderId (duplicate webhook/order completion cannot duplicate commission).
/// commissionRate is snapshot at sale time (historical rate preservation).
model AgencyOrderCommission {
  id               String   @id @default(uuid()) @db.Uuid
  orderId          String   @unique
  agencyId         String   @db.Uuid
  tenantId         String   @db.Uuid
  grossAmount      Float
  refundAmount     Int      @default(0)
  eligibleRevenue  Float
  commissionRate   Float
  commissionEarned Float
  paidAmount       Float    @default(0)
  outstanding      Float
  status           String   @default("UNPAID")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  allocations      AgencyCommissionAllocation[]

  @@index([agencyId, createdAt])
  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

/// RCCF-LAUNCH-10 — manual agency payout (NO automated transfer)
/// Super Admin records a manual payment against one or more commissions.
model AgencyCommissionPayment {
  id         String   @id @default(uuid()) @db.Uuid
  agencyId   String   @db.Uuid
  amount     Float
  reference  String?
  note       String?
  adminId    String?  @db.Uuid
  adminEmail String?
  createdAt  DateTime @default(now())

  allocations AgencyCommissionAllocation[]

  @@index([agencyId, createdAt])
}

model AgencyCommissionAllocation {
  id           String   @id @default(uuid()) @db.Uuid
  paymentId    String   @db.Uuid
  commissionId String   @db.Uuid
  amount       Float
  createdAt    DateTime @default(now())

  payment    AgencyCommissionPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  commission AgencyOrderCommission   @relation(fields: [commissionId], references: [id], onDelete: Cascade)

  @@unique([paymentId, commissionId])
  @@index([commissionId])
}

/// RCCF-31 — per-tenant commercial usage meter for metered capabilities
/// (currently: publish quota). One row per (tenant, feature, period window);
/// `periodStart` is the period anchor so lifetime (single row) and monthly
/// (one row per period) both map cleanly. `used` is incremented atomically
/// inside the same transaction as the published snapshot write.
model PlanUsage {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String    @db.Uuid
  featureKey  String
  periodStart DateTime
  periodEnd   DateTime?
  used        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([tenantId, featureKey, periodStart])
  @@index([tenantId, featureKey])
}
